{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "lib": ["DOM", "ES2018"]
  },
  "include": ["public/src/**/*.ts", "public/src/**/*.d.ts"],
  "exclude": ["node_modules"]
}
